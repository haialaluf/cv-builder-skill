{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cv.schema.json",
  "title": "CV",
  "description": "Data model for a single CV. All templates render from this shape.",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,

  "properties": {

    "name": {
      "type": "string",
      "description": "Full name as it should appear on the CV.",
      "minLength": 1
    },

    "headline": {
      "type": "string",
      "description": "One-line role title or tagline shown directly under the name.",
      "examples": ["Product Manager", "Senior Full Stack Developer", "Software Engineer"]
    },

    "summary": {
      "type": "string",
      "description": "Profile paragraph. 2–3 sentences (~50 words). Plain text only (no HTML).",
      "minLength": 1
    },

    "contact": {
      "type": "array",
      "description": "Contact entries rendered in order. Each entry pairs a display label with an icon and an optional URL.",
      "items": {
        "type": "object",
        "required": ["name", "icon"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "The visible label. E.g. 'maya@example.com', '+972 50 123 4567', 'Tel Aviv, IL', '/in/mayachen'.",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "description": "Icon key. Unknown values fall back to the generic 'link' icon.",
            "enum": ["email", "phone", "location", "website", "linkedin", "github", "x", "stackoverflow", "link"]
          },
          "link": {
            "type": "string",
            "description": "Full URL (including scheme). Omit for non-clickable entries like phone or location.",
            "format": "uri"
          }
        }
      }
    },

    "experience": {
      "type": "array",
      "description": "Work history, most-recent first.",
      "items": {
        "type": "object",
        "required": ["title", "company", "startDate", "endDate"],
        "additionalProperties": false,
        "properties": {
          "title":     { "type": "string", "description": "Job title." },
          "company":   { "type": "string", "description": "Employer name." },
          "url":       { "type": "string", "format": "uri", "description": "Company website URL. Optional. When present, the company name renders as a link." },
          "location":  { "type": "string", "description": "Office location or 'Remote'. Optional." },
          "startDate": { "type": "string", "description": "Year or 'Month YYYY'. E.g. 2023 or Jan 2023" },
          "endDate":   { "type": "string", "description": "Year, 'Month YYYY', or 'Present'." },
          "tagline":   { "type": "string", "description": "Optional one-line tagline under the role title, JD-customised. The single strongest tailoring lever — emphasise the aspect of the role most relevant to the target JD. E.g. 'Built developer tools for internal engineering teams'. Plain text." },
          "bullets": {
            "type": "array",
            "description": "Achievement statements. May include inline <strong> for emphasis. 2–5 per role recommended.",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "tech": {
            "type": "array",
            "description": "Technology tags rendered as pills/badges.",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },

    "education": {
      "type": "array",
      "description": "Degrees and certifications, most-recent first.",
      "items": {
        "type": "object",
        "required": ["degree", "school", "startDate", "endDate"],
        "additionalProperties": false,
        "properties": {
          "degree":    { "type": "string", "description": "Full degree name. E.g. B.Sc. Computer Science" },
          "school":    { "type": "string", "description": "Institution name." },
          "startDate": { "type": "string", "description": "Year. E.g. 2014" },
          "endDate":   { "type": "string", "description": "Year or 'Present'." },
          "note":      { "type": "string", "description": "Optional honours, thesis title, or GPA note." }
        }
      }
    },

    "skills": {
      "type": "array",
      "description": "Technical skills. Rendered as a flat list in both templates.",
      "items": { "type": "string", "minLength": 1 }
    },

    "languages": {
      "type": "array",
      "description": "Spoken/written languages.",
      "items": {
        "type": "object",
        "required": ["name", "level"],
        "additionalProperties": false,
        "properties": {
          "name":  { "type": "string", "minLength": 1 },
          "level": {
            "type": "string",
            "description": "Fluency label shown as-is.",
            "examples": ["Native", "Fluent", "Professional", "Conversational", "Basic"]
          }
        }
      }
    },

    "projects": {
      "type": "array",
      "description": "Side-projects, open-source work, publications, or talks.",
      "items": {
        "type": "object",
        "required": ["title", "description", "startDate"],
        "additionalProperties": false,
        "properties": {
          "title":       { "type": "string", "minLength": 1 },
          "description": { "type": "string", "description": "One or two sentences. Plain text.", "minLength": 1 },
          "startDate":   { "type": "string", "description": "Year or 'Month YYYY'." },
          "endDate":     { "type": "string", "description": "Year, 'Month YYYY', 'now', or omit if point-in-time." }
        }
      }
    },

    "certifications": {
      "type": "array",
      "description": "Professional certifications and licenses, most-recent first.",
      "items": {
        "type": "object",
        "required": ["name", "issuer"],
        "additionalProperties": false,
        "properties": {
          "name":   { "type": "string", "minLength": 1, "description": "Certification name. E.g. 'AWS Solutions Architect — Associate'." },
          "issuer": { "type": "string", "minLength": 1, "description": "Issuing body. E.g. 'Amazon Web Services'." },
          "date":   { "type": "string", "description": "Year or 'Month YYYY'. Optional." },
          "link":   { "type": "string", "format": "uri", "description": "Verification URL. Optional." }
        }
      }
    },

    "awards": {
      "type": "array",
      "description": "Awards, honours, and recognition. Distinct from projects — these are things received, not things made.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name":   { "type": "string", "minLength": 1, "description": "Award or honour name." },
          "issuer": { "type": "string", "description": "Awarding body. Optional." },
          "date":   { "type": "string", "description": "Year or 'Month YYYY'. Optional." }
        }
      }
    }

  }
}
